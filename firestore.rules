rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && role in request.auth.token.get('roles', []);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin') || hasRole('operations_admin');
    }

    function isSupportAdmin() {
      return isAdmin() || hasRole('support_admin');
    }

    function isVendor(vendorId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/vendors/$(vendorId))
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.userId == request.auth.uid;
    }

    function isDriver(driverId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/drivers/$(driverId))
        && get(/databases/$(database)/documents/drivers/$(driverId)).data.userId == request.auth.uid;
    }

    // The signed-in user is the driver assigned to this delivery.
    function isDeliveryDriver(deliveryId) {
      return deliveryId != null
        && exists(/databases/$(database)/documents/deliveries/$(deliveryId))
        && 'driverId' in get(/databases/$(database)/documents/deliveries/$(deliveryId)).data
        && isDriver(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.driverId);
    }

    // The only steps a vendor may take on their own sub-order, strictly in order.
    function vendorOrderStep(fromStatus, toStatus) {
      return (fromStatus == 'pending' && toStatus == 'confirmed')
        || (fromStatus == 'confirmed' && toStatus == 'processing')
        || (fromStatus == 'processing' && toStatus == 'ready_for_pickup');
    }

    function platformSettings() {
      return get(/databases/$(database)/documents/platformSettings/global).data;
    }

    // Delivery fee the customer must be charged, from admin-managed settings.
    function expectedDeliveryCharge(subtotal) {
      return (platformSettings().freeDeliveryThreshold > 0 && subtotal >= platformSettings().freeDeliveryThreshold)
        ? 0 : platformSettings().deliveryChargeFlat;
    }

    // A coupon (document id = the code) that is live, meets its minimum, and whose discount does not exceed what it allows.
    function couponAllows(code, subtotal, discount) {
      let c = get(/databases/$(database)/documents/coupons/$(code)).data;
      let pct = math.floor(subtotal * c.discountValue / 100);
      let capped = (c.get('maxDiscountAmount', null) != null && c.maxDiscountAmount < pct) ? c.maxDiscountAmount : pct;
      let allowed = c.discountType == 'percentage' ? capped : c.discountValue;
      return exists(/databases/$(database)/documents/coupons/$(code))
        && c.isActive == true
        && c.validFrom <= request.time
        && c.validUntil >= request.time
        && subtotal >= c.minOrderAmount
        && discount <= allowed;
    }

    // The vendor exists and is approved (does NOT require the caller to own it).
    function isLiveVendor(vendorId) {
      return exists(/databases/$(database)/documents/vendors/$(vendorId))
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.status == 'approved'
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('isOpen', true) == true;
    }

    function isApprovedVendor(vendorId) {
      return isVendor(vendorId)
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.status == 'approved';
    }

    function isApprovedDriver() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status in ['approved', 'active', 'offline'];
    }

    function isValidTimestamp(ts) {
      return ts == request.time;
    }

    // ===== PUBLIC COLLECTIONS =====
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /platformSettings/{id} {
      // Public: holds storefront values (delivery fee, support contact, maintenance flag). No secrets live here.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== PRODUCTS (public catalog with restrictions) =====
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin()
        || isVendor(resource.data.vendorId);
      // Vendors can only submit NEW products for moderation, at the platform commission rate.
      allow create: if isAuthenticated()
        && isApprovedVendor(request.resource.data.vendorId)
        && request.resource.data.status == 'pending_review'
        && request.resource.data.isFeatured == false
        && request.resource.data.commissionRate == get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.commissionRate
        && request.resource.data.basePrice > 0;
      // Vendors may edit their listing but never approval state, commission, ownership or stats.
      allow update: if (isVendor(resource.data.vendorId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['status', 'commissionRate', 'vendorId', 'isFeatured', 'metadata'])
          && request.resource.data.basePrice > 0
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3)
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /productVariants/{variantId} {
      allow read: if isAuthenticated() || 
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.status == 'published';
      allow write: if isAdmin() || isVendor(resource.data.vendorId);
    }

    // ===== INVENTORY =====
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();
      // Vendors manage stock for their own products; reservations are handled by functions/admin.
      allow create: if isApprovedVendor(request.resource.data.vendorId)
        && request.resource.data.reservedQuantity == 0;
      allow update: if isAdmin()
        || (isVendor(resource.data.vendorId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vendorId', 'productId', 'reservedQuantity'])
            && request.resource.data.quantity >= 0
            && request.resource.data.reorderLevel >= 0);
      allow delete: if isAdmin();
    }

    // Every stock change a vendor makes (manual adjustment or order accepted) is recorded here.
    match /inventoryLogs/{logId} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow create: if isVendor(request.resource.data.vendorId)
        && request.resource.data.productId is string
        && request.resource.data.after >= 0;
      allow update, delete: if false;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isCurrentUser(userId) || isAdmin();
      allow create: if isCurrentUser(userId) || isAdmin();
      allow update: if isCurrentUser(userId)
        && !('roles' in request.resource.data.diff(resource.data).affectedKeys())
        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
        || isAdmin();
    }

    // ===== ADDRESSES =====
    match /addresses/{addressId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid
        || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid)
        || isAdmin();
    }

    // ===== CARTS =====
    match /carts/{cartId} {
      allow read, write: if isCurrentUser(cartId) || isAdmin();
    }

    // ===== WISHLISTS =====
    match /wishlists/{wishlistId} {
      allow read, write: if isCurrentUser(wishlistId) || isAdmin();
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid || isAdmin();
      // Customers place Cash-on-Delivery orders directly (online payments need the payment backend).
      // Rules re-check the money maths and the delivery fee against admin settings.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.pricing.subtotal > 0
        && request.resource.data.pricing.couponDiscount >= 0
        && request.resource.data.pricing.couponDiscount <= request.resource.data.pricing.subtotal
        && (request.resource.data.pricing.couponDiscount == 0
            || (request.resource.data.couponCode != null
                && couponAllows(request.resource.data.couponCode, request.resource.data.pricing.subtotal, request.resource.data.pricing.couponDiscount)
                && !exists(/databases/$(database)/documents/couponRedemptions/$(request.auth.uid + '_' + request.resource.data.couponCode))
                && existsAfter(/databases/$(database)/documents/couponRedemptions/$(request.auth.uid + '_' + request.resource.data.couponCode))))
        && request.resource.data.pricing.deliveryCharge == expectedDeliveryCharge(request.resource.data.pricing.subtotal)
        && request.resource.data.pricing.grandTotal ==
            request.resource.data.pricing.subtotal + request.resource.data.pricing.deliveryCharge
            - request.resource.data.pricing.couponDiscount;
      allow update, delete: if isAdmin();
    }

    match /vendorOrders/{vendorOrderId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || isVendor(resource.data.vendorId)
        || isDeliveryDriver(resource.data.get('deliveryId', null));
      // Created together with the customer's order; commission must match the vendor's own rate.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && isLiveVendor(request.resource.data.vendorId)
        && request.resource.data.commissionAmount ==
            math.round(request.resource.data.subtotal * get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.commissionRate)
        && request.resource.data.vendorEarning == request.resource.data.subtotal - request.resource.data.commissionAmount;
      // The vendor moves their own sub-order through preparation (accept, pack, ready), one step at a time.
      // The assigned driver marks it dispatched once picked up and delivered once handed over.
      allow update: if isAdmin()
        || (isVendor(resource.data.vendorId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt'])
            && vendorOrderStep(resource.data.status, request.resource.data.status))
        || (isDeliveryDriver(resource.data.get('deliveryId', null))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt'])
            && ((request.resource.data.status == 'dispatched'
                  && resource.data.status == 'ready_for_pickup'
                  && get(/databases/$(database)/documents/deliveries/$(resource.data.deliveryId)).data.status
                      in ['picked_up', 'in_transit', 'out_for_delivery'])
                || (request.resource.data.status == 'delivered'
                  && resource.data.status in ['ready_for_pickup', 'dispatched']
                  && get(/databases/$(database)/documents/deliveries/$(resource.data.deliveryId)).data.status == 'delivered')));
      allow delete: if isAdmin();
    }

    // ===== PAYMENTS =====
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin(); // Only via admin SDK
    }

    match /paymentEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ===== DELIVERIES =====
    match /deliveries/{deliveryId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || isDriver(resource.data.driverId)
        // Approved drivers can see unassigned jobs that are waiting for a driver.
        || (resource.data.status == 'pending_assignment' && isApprovedDriver());
      // Created with the customer's order, unassigned, paying the admin-configured driver fee.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending_assignment'
        && !('driverId' in request.resource.data)
        && request.resource.data.driverEarning == platformSettings().driverEarningPerDelivery;
      allow update: if isAdmin()
        // An approved, online driver can claim an unassigned job (first one to claim it wins).
        || (isApprovedDriver()
            && resource.data.status == 'pending_assignment'
            && !('driverId' in resource.data)
            && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.isOnline == true
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['driverId', 'driverName', 'status', 'statusHistory', 'updatedAt'])
            && request.resource.data.driverId == request.auth.uid
            && request.resource.data.status == 'driver_accepted')
        // Assigned driver moves the job through pickup / transit...
        || (isDriver(resource.data.driverId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt'])
            && request.resource.data.status in ['driver_accepted', 'driver_at_vendor', 'picked_up', 'in_transit', 'out_for_delivery']
            // ...but cannot pick the parcel up before the vendor has packed it.
            && (!(request.resource.data.status in ['picked_up', 'in_transit', 'out_for_delivery'])
                || get(/databases/$(database)/documents/vendorOrders/$(resource.data.vendorOrderId)).data.status
                    in ['ready_for_pickup', 'dispatched']))
        // ...and completes it only with the customer's handover PIN (kept in deliveryOtps, unreadable by drivers).
        || (isDriver(resource.data.driverId)
            && resource.data.status in ['picked_up', 'in_transit', 'out_for_delivery']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'deliveredAt', 'updatedAt', 'otpEntered'])
            && request.resource.data.status == 'delivered'
            && request.resource.data.otpEntered == get(/databases/$(database)/documents/deliveryOtps/$(deliveryId)).data.otp);
      allow delete: if isAdmin();
    }

    // Handover PIN for each delivery. Only the customer who owns it (and admins) can read it.
    match /deliveryOtps/{deliveryId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.otp is string
        && request.resource.data.otp.size() == 4;
      allow update, delete: if false;
    }

    match /deliveryEvents/{eventId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ===== VENDORS =====
    match /vendors/{vendorId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || isVendor(vendorId);
      // New vendor stores can only be created as pending; admins approve them.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_review';
      // A store owner edits their own profile, contact, pickup address, payout details, hours and policies.
      // Approval status, commission, ownership and sales figures stay admin-only.
      allow update: if (isVendor(vendorId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['storeName', 'description', 'logoURL', 'bannerURL', 'email', 'phone', 'gstNumber', 'panNumber',
                        'address', 'isOpen', 'pauseReason', 'openingHours', 'prepTimeDays',
                        'shippingPolicy', 'returnPolicy', 'returnWindowDays', 'updatedAt']))
        || isAdmin();
    }

    // Payout bank details: readable only by the store owner and admins (the public vendor record is open to everyone).
    match /vendorPrivate/{vendorId} {
      allow read: if isAdmin() || isVendor(vendorId);
      allow create, update: if isVendor(vendorId)
        && request.resource.data.keys().hasOnly(['bankDetails', 'userId', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    match /vendorApplications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== DRIVERS =====
    match /drivers/{driverId} {
      allow read: if isAdmin() || isDriver(driverId);
      // New driver profiles can only be created as pending; admins approve them.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_review';
      allow update: if isAdmin()
        || (isDriver(driverId)
          // A driver may change availability and their own contact/payout details, never approval state, vehicle/licence or earnings.
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isOnline', 'status', 'currentLocation', 'lastSeenAt', 'updatedAt',
                       'displayName', 'phone', 'serviceArea', 'emergencyContact', 'bankDetails'])
          && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
              || (resource.data.status in ['approved', 'active', 'offline']
                  && request.resource.data.status in ['active', 'offline'])));
    }

    match /driverApplications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== FINANCIAL =====
    match /commissions/{id} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow write: if isAdmin();
    }

    match /settlementLedger/{id} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow write: if isAdmin();
    }

    match /settlements/{id} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow write: if isAdmin();
    }

    // ===== PAYOUT REQUESTS =====
    // A vendor or driver asks to withdraw earned money; an admin pays or rejects it.
    //  - Only the requester's own pending request can be created, for at least the admin-set minimum.
    //  - A matching lock document (created in the same write) allows only ONE open request per vendor/driver.
    //  - The requester may only cancel their own pending request; admins alone mark requests paid or rejected.
    function payoutRequesterOk(d) {
      return (d.requesterType == 'vendor' && isApprovedVendor(d.requesterId))
        || (d.requesterType == 'driver' && isDriver(d.requesterId)
            && get(/databases/$(database)/documents/drivers/$(d.requesterId)).data.status in ['approved', 'active', 'offline']);
    }

    match /payoutRequests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['requesterType', 'requesterId', 'requesterName', 'userId', 'amount', 'status', 'bank', 'note', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterType in ['vendor', 'driver']
        && payoutRequesterOk(request.resource.data)
        && request.resource.data.amount is int
        && request.resource.data.amount >= platformSettings().get('minPayoutAmount', 10000)
        && request.resource.data.amount <= 100000000
        && request.resource.data.bank.accountNumber is string
        && request.resource.data.bank.accountNumber.size() >= 9
        && request.resource.data.bank.ifscCode is string
        && request.resource.data.bank.accountHolder is string
        && request.resource.data.get('note', '').size() <= 300
        && existsAfter(/databases/$(database)/documents/payoutLocks/$(request.resource.data.requesterType + '_' + request.resource.data.requesterId))
        && getAfter(/databases/$(database)/documents/payoutLocks/$(request.resource.data.requesterType + '_' + request.resource.data.requesterId)).data.requestId == requestId;

      allow update: if (isAdmin()
            && resource.data.status == 'pending'
            && request.resource.data.status in ['paid', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'referenceNumber', 'adminNote', 'processedBy', 'processedByEmail', 'processedAt', 'updatedAt'])
            && (request.resource.data.status != 'paid'
                || (request.resource.data.referenceNumber is string && request.resource.data.referenceNumber.size() >= 4)))
        || (isAuthenticated()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt']));

      allow delete: if false;
    }

    match /payoutLocks/{lockId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['requestId', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/payoutRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/payoutRequests/$(request.resource.data.requestId)).data.userId == request.auth.uid
        && lockId == getAfter(/databases/$(database)/documents/payoutRequests/$(request.resource.data.requestId)).data.requesterType
                     + '_' + getAfter(/databases/$(database)/documents/payoutRequests/$(request.resource.data.requestId)).data.requesterId;
      allow update: if false;
      // Released when an admin decides the request, or when the requester cancels it.
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/payoutRequests/$(resource.data.requestId)).data.status == 'cancelled');
    }

    // ===== COUPONS =====
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /couponRedemptions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // One use per customer: the id is "<uid>_<code>", so a second order with the same code is refused.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.couponCode
        && request.resource.data.keys().hasOnly(['couponId', 'couponCode', 'userId', 'orderId', 'discountAmount', 'createdAt', 'updatedAt']);
      allow update, delete: if isAdmin();
    }

    // ===== REVIEWS =====
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      // One review per customer per product (id = "<uid>_<productId>"). It starts as 'pending' until an admin approves it,
      // and must point at a delivered order of that customer from the same store.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && reviewId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.status == 'pending'
        && request.resource.data.isVerifiedPurchase == true
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.get('body', '').size() <= 1000
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.helpfulCount == 0
        && exists(/databases/$(database)/documents/vendorOrders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/vendorOrders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/vendorOrders/$(request.resource.data.orderId)).data.vendorId == request.resource.data.vendorId
        && get(/databases/$(database)/documents/vendorOrders/$(request.resource.data.orderId)).data.status == 'delivered';
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'title', 'body', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // ===== SUPPORT TICKETS =====
    match /supportTickets/{ticketId} {
      allow read: if isSupportAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isSupportAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid
          && resource.data.status == 'open');
    }

    // ===== AUDIT LOGS =====
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Only via admin SDK in functions
    }

    // ===== SERVICEABILITY ZONES =====
    match /serviceabilityZones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== DENY ALL ELSE =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
