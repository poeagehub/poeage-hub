{
  "name": "poeage-hub",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "admin",
    "user",
    "vendor",
    "driver",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w user\" \"npm run dev -w admin\" \"npm run dev -w vendor\" \"npm run dev -w driver\"",
    "dev:user": "npm run dev -w user",
    "dev:admin": "npm run dev -w admin",
    "dev:vendor": "npm run dev -w vendor",
    "dev:driver": "npm run dev -w driver",
    "build": "npm run build --workspaces --if-present",
    "build:user": "npm run build -w user",
    "build:admin": "npm run build -w admin",
    "build:vendor": "npm run build -w vendor",
    "build:driver": "npm run build -w driver",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "tsx --test tests/*.test.ts",
    "emulators": "firebase emulators:start",
    "seed": "tsx scripts/seed/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "lucide-react": "^1.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "engines": {
    "node": "26.x"
  }
}
