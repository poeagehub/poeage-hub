# Firebase web app config — Firebase Console → Project settings → General → Your apps (Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Behaviour switches
VITE_USE_EMULATORS=false
VITE_USE_CLOUD_FUNCTIONS=false

# Where each app lives. Local dev ports are shown; use your Vercel domains in production.
VITE_USER_APP_URL=http://localhost:5180
VITE_ADMIN_APP_URL=http://localhost:5181
VITE_VENDOR_APP_URL=http://localhost:5182
VITE_DRIVER_APP_URL=http://localhost:5183
VITE_GOOGLE_MAPS_API_KEY=
