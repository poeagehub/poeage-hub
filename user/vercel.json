{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo?type=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?type=index"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/seo?type=pages"
    },
    {
      "source": "/sitemap-info.xml",
      "destination": "/api/seo?type=info"
    },
    {
      "source": "/sitemap-categories.xml",
      "destination": "/api/seo?type=categories"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/seo?type=products"
    },
    {
      "source": "/sitemap-stores.xml",
      "destination": "/api/seo?type=stores"
    },
    {
      "source": "/sitemap-store-products.xml",
      "destination": "/api/seo?type=store-products"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
